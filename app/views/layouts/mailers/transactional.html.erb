<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      body {
        font-family: sans-serif;
      }
      code {
        font-size: 1.15em;
        margin: 2em 0;
        display: block;
      }
      h1 {
        font-size: 1.4em;
        margin: 1em 0 1.5em 0;
        font-family: Arial, sans-serif;
      }
    </style>
  </head>
  <body>
    <div style="max-width: 700px; margin: 30px auto;">
      <img src="<%= root_url(locale: nil) %>logo_email_app.png" style="width:64px; height: 64px; margin: 1em 0;">

      <%= yield %>

      <p style="margin: 5em 0 1em 0;"></p>
      <%# The URL is built here, not in the mailer: each action sets the user's locale only once it runs. %>
      <% if @alert_switch %>
      <p style="font-size: 0.85em; color: #888;"><%= t('mailer.alert_footer_html', url: settings_account_url) %></p>
      <% end %>
    </div>
  </body>
</html>
